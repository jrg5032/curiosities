{
  "manifest_version": 3,
  "name": "Google Chat Sub-Bullets",
  "version": "1.0",
  "description": "Enables Tab/Shift+Tab indentation for nested bullet lists in Google Chat",
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/chat/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
